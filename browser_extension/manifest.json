{
  "manifest_version": 3,
  "name": "Comic Translate Local",
  "version": "0.1.0",
  "description": "Translate comic images through the local Comic-Translate web server.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Comic Translate",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
