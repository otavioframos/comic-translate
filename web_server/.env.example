# ── Comic-Translate Local Server — configuration ───────────────────────────
# Copy this file to ".env" (same folder) and edit the values below.
# You normally only ever change ONE line: OLLAMA_MODEL, when moving machines.

# --- Where the server listens. Keep on localhost (127.0.0.1) for safety. -----
CT_HOST=127.0.0.1
CT_PORT=8000

# --- Translation engine: local Ollama (free, private, no API key) ------------
# This is the ONLY line that changes between machines:
#   MacBook Air  (8–16 GB RAM):  qwen2.5:7b      <- start here for testing
#   iMac         (24 GB+ RAM):   qwen2.5:14b     <- better quality
#   iMac, top quality:           qwen2.5:32b     <- only if RAM is comfortable
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434

# --- Languages you read --------------------------------------------------------
# Source supported here: Japanese, Korean, Chinese
DEFAULT_SOURCE_LANG=Japanese
DEFAULT_TARGET_LANG=English

# --- Debug: when true, the server saves each pipeline stage as a PNG ----------
# The test checklist uses this to see WHERE a problem is. Set false for normal use.
CT_DEBUG=true
CT_DEBUG_DIR=./debug_out
